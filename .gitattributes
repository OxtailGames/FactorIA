# JSON files are checked out with LF line endings on every platform. The engine writes scenes, prefabs and other JSON
# with LF, and tests compare committed scene files with what the engine writes byte for byte (scene.format also treats
# CRLF as not canonical), so a CRLF checkout on Windows would fail them.
*.json text eol=lf

# The embedded gamepad database is compared and parsed as-is: LF on every checkout, so the binary is the same everywhere.
external/sdl_gamecontrollerdb/gamecontrollerdb_linux.txt text eol=lf
external/sdl_gamecontrollerdb/gamecontrollerdb_windows.txt text eol=lf

# The Windows fake CLI of the AI tests runs through cmd.exe: CRLF on every checkout.
tools/ai/tests/fixtures/*.cmd text eol=crlf

# The Gradle wrapper of the Android template is embedded into factoria and written into every exported project byte for
# byte (platforms/android): a CRLF gradlew from a Windows checkout would not run on Linux/macOS, and an LF gradlew.bat
# is not a valid batch file.
platforms/android/gradlew text eol=lf
*.bat text eol=crlf
*.jar binary

# KTX2 textures (an export writes them, tests/data holds a few): never touch their bytes.
*.ktx2 binary
# Golden images of the render and CLI tests: compared by pixels, never touched (no eol conversion, no diff).
engine/render/tests/golden/*.png binary
tools/cli/tests/golden/*.png binary
# Licence texts are embedded in the factoria binary and embedded as they are: LF on every checkout.
tools/shaders/licenses/*.txt text eol=lf

# The mesh shader template is hashed into every compiled material twin and embedded in factoria (custom materials): LF on
# every checkout so that the hash and the embedded files are the same on every host. Twins are JSON.
engine/render/shaders/*.glsl text eol=lf
*.shader text eol=lf

# Codec interop fixtures made by the reference zstd and lz4 tools (engine/core/tests/data/codecs/README.md): never touch their bytes.
engine/core/tests/data/codecs/*.zst binary
engine/core/tests/data/codecs/*.lz4 binary
engine/core/tests/data/codecs/*.bin binary

# The CLI contract fixtures are compared with parsed output line by line: LF on every checkout.
tools/ai/tests/fixtures/cli/** text eol=lf

# Fuzz corpus files are inputs, byte for byte (some are damaged on purpose, some are JSON or text with CR or no final newline): no
# eol conversion on any checkout. This line comes after the `*.json` rule, which it overrides for the corpus.
tools/fuzz/corpus/** -text

# Font files: byte for byte (the font tests damage copies of them and the checker reads offsets), no eol conversion, no diff.
*.ttf binary
*.otf binary
*.ttc binary

# Game packs (game.pak): binary archives, byte for byte (the fuzz corpus holds some).
*.pak binary

# Shader snippets of the tests and examples are hashed into the compiled twins (and into the shader-cache keys), and the
# twins (*.shader, above) are compared byte for byte: a CRLF snippet from a Windows checkout would change the hash and make
# every committed twin stale. Fixtures that are compared as text (JSONL, YAML, glTF, the fixture projects' scripts and
# docs) are LF too. Only the eol is pinned; no file is rewritten.
*.glsl text eol=lf
*.jsonl text eol=lf
tools/common/tests/fixtures/** text eol=lf
engine/render/tests/data/*.gltf text eol=lf
tools/cli/tests/fixtures/**/*.js text eol=lf
tools/cli/tests/fixtures/**/*.md text eol=lf

# The generated LTC tables are compared byte for byte with what tools/ltc produces.
engine/render/src/ltc_tables.h text eol=lf

# The ray tracing kernels and their generated headers (tools/shaders/compile_rt_shaders.sh): the headers record the SHA-256 of the
# sources, so LF on every checkout.
engine/render/shaders/rt/* text eol=lf
engine/render/src/shaders/rt/*.rt.h text eol=lf
