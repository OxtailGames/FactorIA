# JSON files are checked out with LF line endings on every platform. The engine writes scenes, prefabs and other JSON
# with LF, and tests compare committed scene files with what the engine writes byte for byte (scene.format also treats
# CRLF as not canonical), so a CRLF checkout on Windows would fail them.
*.json text eol=lf

# The embedded gamepad database is compared and parsed as-is: LF on every checkout, so the binary is the same everywhere.
external/sdl_gamecontrollerdb/gamecontrollerdb_linux.txt text eol=lf

# The Windows fake CLI of the AI tests runs through cmd.exe: CRLF on every checkout.
tools/ai/tests/fixtures/*.cmd text eol=crlf

# The Gradle wrapper of the Android template is embedded into factoria and written into every exported project byte for
# byte (platforms/android): a CRLF gradlew from a Windows checkout would not run on Linux/macOS, and an LF gradlew.bat
# is not a valid batch file.
platforms/android/gradlew text eol=lf
*.bat text eol=crlf
*.jar binary

# KTX2 textures (an export writes them, tests/data holds a few): never touch their bytes.
*.ktx2 binary
# Licence texts are embedded in the factoria binary and embedded as they are: LF on every checkout.
tools/shaders/licenses/*.txt text eol=lf

# The mesh shader template is hashed into every compiled material twin and embedded in factoria (custom materials): LF on
# every checkout so that the hash and the embedded files are the same on every host. Twins are JSON.
engine/render/shaders/*.glsl text eol=lf
*.shader text eol=lf
