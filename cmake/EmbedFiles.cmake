# Script mode: -DNS -DOUT_CPP -DOUT_H -DBASE -DFILES=<;-list>
# Emits each file as a raw byte array so any content (quotes, binary) is safe.
set(h "#pragma once\n#include <span>\n#include <string_view>\nnamespace ${NS} {\nstruct EmbeddedFile { std::string_view path; std::string_view data; };\nstd::span<const EmbeddedFile> files();\n}\n")
file(WRITE ${OUT_H} "${h}")
set(cpp "#include \"${OUT_H}\"\nnamespace ${NS} {\nnamespace {\n")
set(table "")
set(i 0)
foreach(f ${FILES})
    file(RELATIVE_PATH rel ${BASE} ${f})
    file(READ ${f} hex HEX)
    string(LENGTH "${hex}" hexlen)
    math(EXPR nbytes "${hexlen} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND cpp "const unsigned char d${i}[] = {${bytes}0};\n")
    string(APPEND table "    {\"${rel}\", std::string_view(reinterpret_cast<const char*>(d${i}), ${nbytes})},\n")
    math(EXPR i "${i} + 1")
endforeach()
string(APPEND cpp "const EmbeddedFile kFiles[] = {\n${table}    {{}, {}}\n};\n}\n")
string(APPEND cpp "std::span<const EmbeddedFile> files() { return {kFiles, sizeof(kFiles) / sizeof(kFiles[0]) - 1}; }\n}\n")
file(WRITE ${OUT_CPP} "${cpp}")
