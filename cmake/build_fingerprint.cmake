# Writes the build fingerprint header (fa_build_fingerprint.h) used by fa/core/build_info.h. Run at every build as
#   cmake -DOUT=<header> -DSRC=<checkout> -DGIT=<git executable or empty> -P build_fingerprint.cmake
# The fingerprint is the checkout's commit (12 hex digits), with "-dirty" when tracked files have uncommitted changes, or
# "unknown" outside a git checkout (source archives): programs that carry "unknown" are not compared. The header is only
# rewritten when the fingerprint changes, so a build with the same commit recompiles nothing.
set(fingerprint "unknown")
if(GIT)
    execute_process(COMMAND "${GIT}" -C "${SRC}" rev-parse --short=12 HEAD
        OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
    if(rc EQUAL 0 AND head MATCHES "^[0-9a-f]+$")
        set(fingerprint "${head}")
        execute_process(COMMAND "${GIT}" -C "${SRC}" status --porcelain --untracked-files=no
            OUTPUT_VARIABLE changes ERROR_QUIET RESULT_VARIABLE rc2)
        if(rc2 EQUAL 0 AND NOT "${changes}" STREQUAL "")
            set(fingerprint "${fingerprint}-dirty")
        endif()
    endif()
endif()
set(content "// Generated by cmake/build_fingerprint.cmake at build time: do not edit.\n#define FA_BUILD_FINGERPRINT \"${fingerprint}\"\n")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT "${old}" STREQUAL "${content}")
    file(WRITE "${OUT}" "${content}")
endif()
