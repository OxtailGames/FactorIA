<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated from platforms/ios/Info.plist.in by player/CMakeLists.txt (@VARS@ come from CMake). -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>@FA_GAME_BUNDLE_ID@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>@FA_GAME_NAME_XML@</string>
	<key>CFBundleDisplayName</key>
	<string>@FA_GAME_NAME_XML@</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@FA_GAME_VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@FA_GAME_BUILD_VALUE@</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	@FA_IOS_NON_EXEMPT_ENCRYPTION@
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>@CMAKE_OSX_DEPLOYMENT_TARGET@</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>metal</string>
	</array>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		@FA_IOS_ORIENTATIONS@
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		@FA_IOS_ORIENTATIONS_IPAD@
	</array>
@FA_IOS_PLIST_EXTRA@</dict>
</plist>
