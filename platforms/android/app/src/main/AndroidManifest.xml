<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
{{USES_PERMISSIONS}}
    <application
        android:label="@string/app_name"{{APP_ICON_ATTRS}}
        android:appCategory="game"
        android:hasCode="false"
        android:allowBackup="false"
        android:supportsRtl="true">

        <!-- sokol_app implements ANativeActivity_onCreate in libfactoria_player.so.
             configChanges: every configuration change the player can ignore. Android restarts an activity for any change
             it does not list, and a restarted NativeActivity ends the whole process (sokol_app calls exit(0) in
             onDestroy), so the game would just vanish: mcc|mnc when the SIM loads (the emulator does it a few seconds
             after boot), locale|layoutDirection when the system language changes, fontScale|fontWeightAdjustment when
             the user changes the font size, colorMode with the display's colour gamut.
             stateNotNeeded: one restart cannot be declared: a change of the assets paths (wallpaper colours or theme on
             Android 12+, an overlay; `am update-appinfo` does the same) relaunches every activity. The process ends in
             the middle of that relaunch, and Android drops an activity whose process died without saved state ("app
             died, no saved state"): the game vanished. With stateNotNeeded the system starts it again in a new
             process, as it does for launchers. -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:screenOrientation="{{SCREEN_ORIENTATION}}"
            android:configChanges="mcc|mnc|locale|layoutDirection|fontScale|fontWeightAdjustment|colorMode|orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|smallestScreenSize|uiMode|density"
            android:stateNotNeeded="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <meta-data android:name="android.app.lib_name" android:value="factoria_player" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
