{
  "format": "factoria.scene/1",
  "settings": { "gravity2D": [0, 0] },
  "entities": [
    {
      "id": "camera",
      "name": "Main Camera",
      "components": {
        "Camera": { "projection": "orthographic", "clearColor": [0.08, 0.09, 0.14, 1], "primary": true }
      }
    },
    {
      "id": "player",
      "name": "Player",
