        "Shape2D": { "shape": "rectangle", "size": [48, 48], "color": [0.95, 0.75, 0.2, 1], "layer": 1 },
        "Script": { "path": "scripts/player.js", "props": { "speed": 300 } }
      }
    },
    {
      "id": "title",
      "name": "Title",
      "components": {
        "Transform": { "position": [24, 24, 0] },
        "Text": {
          "text": "{{PROJECT_NAME}}: move with WASD / arrows",
          "fontSize": 24,
          "color": [1, 1, 1, 1],
          "pivot": [0, 1],
          "space": "screen",
          "layer": 100
        }
