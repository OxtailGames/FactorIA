{
  "$comment": "The building catalogue (the palette order is the order of this file). kind: road | building. size = [cells along c, cells along r] at rotation 0 (odd rotations swap it); rotation r faces: 0 = +c (down-right on screen), 1 = +r (down-left), 2 = -c (up-left), 3 = -r (up-right); the frontage is the row of cells just outside the footprint on that side. cost = coins and/or goods paid on placement. terrain = ids a footprint cell may stand on (default: the terrain's `buildable`). nearWater: a footprint cell touches water. requireRoad: frontage = a road cell on the frontage. housing = villagers that live here. workers = jobs: producers staff their recipes with them, a warehouse's workers are its carriers, a market's workers keep it open. storage = what a warehouse adds to the town's stock limit (data/economy.json sim.baseStorage is the limit without one). upkeep = coins paid per game day. jobPriority = who gets workers first (lower first). recipes: ids of recipes.json this building runs. A building also needs a road cell next to any side of it to be connected to the town (villagers and carriers walk on roads). The name and description are the locale strings building.<id>.name and building.<id>.desc.",
  "format": "tidewater.buildings/2",
  "buildings": {
    "road":        { "kind": "road",     "category": "infrastructure", "size": [1, 1], "cost": { "coins": 2 },                       "terrain": ["sand", "grass"] },
    "house":       { "kind": "building", "category": "housing",        "size": [1, 1], "cost": { "coins": 40, "wood": 4 },            "terrain": ["sand", "grass"], "housing": 4, "upkeep": 0 },
    "farm":        { "kind": "building", "category": "production",     "size": [2, 2], "cost": { "coins": 90, "wood": 6 },            "terrain": ["grass"], "workers": 2, "upkeep": 1, "jobPriority": 3, "recipes": ["harvest_grain"] },
    "fisher_dock": { "kind": "building", "category": "production",     "size": [2, 1], "cost": { "coins": 70, "wood": 8 },            "terrain": ["sand", "grass"], "nearWater": true, "workers": 2, "upkeep": 1, "jobPriority": 3, "recipes": ["catch_fish"] },
    "lumber_camp": { "kind": "building", "category": "production",     "size": [2, 2], "cost": { "coins": 60 },                       "terrain": ["forest", "grass"], "workers": 2, "upkeep": 1, "jobPriority": 3, "recipes": ["cut_wood"] },
    "quarry":      { "kind": "building", "category": "production",     "size": [2, 2], "cost": { "coins": 110, "wood": 8 },           "terrain": ["rock"], "workers": 3, "upkeep": 2, "jobPriority": 4, "recipes": ["cut_stone"] },
    "sawmill":     { "kind": "building", "category": "production",     "size": [2, 2], "cost": { "coins": 120, "wood": 10 },          "terrain": ["sand", "grass"], "workers": 2, "upkeep": 1, "jobPriority": 3, "recipes": ["saw_planks"] },
    "mill":        { "kind": "building", "category": "production",     "size": [2, 2], "cost": { "coins": 100, "planks": 5 },         "terrain": ["sand", "grass"], "workers": 2, "upkeep": 1, "jobPriority": 3, "recipes": ["mill_flour"] },
    "bakery":      { "kind": "building", "category": "production",     "size": [2, 2], "cost": { "coins": 130, "planks": 4 },         "terrain": ["sand", "grass"], "workers": 2, "upkeep": 1, "jobPriority": 3, "recipes": ["bake_bread_flour", "bake_bread"] },
    "smokehouse":  { "kind": "building", "category": "production",     "size": [2, 2], "cost": { "coins": 90, "planks": 4 },          "terrain": ["sand", "grass"], "workers": 2, "upkeep": 1, "jobPriority": 3, "recipes": ["smoke_fish"] },
    "workshop":    { "kind": "building", "category": "production",     "size": [2, 2], "cost": { "coins": 160, "planks": 6, "stone": 4 }, "terrain": ["sand", "grass"], "workers": 3, "upkeep": 2, "jobPriority": 5, "recipes": ["make_tools"] },
    "warehouse":   { "kind": "building", "category": "storage",        "size": [3, 2], "cost": { "coins": 150, "planks": 8 },         "terrain": ["sand", "grass"], "requireRoad": "frontage", "storage": 400, "workers": 3, "upkeep": 2, "jobPriority": 1 },
    "market":      { "kind": "building", "category": "trade",          "size": [3, 2], "cost": { "coins": 200, "planks": 10 },        "terrain": ["sand", "grass"], "requireRoad": "frontage", "workers": 2, "upkeep": 2, "jobPriority": 0 }
