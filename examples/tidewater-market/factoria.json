{
  "format": "factoria.project/1",
  "name": "Tidewater Market",
  "id": "com.oxtailgames.tidewatermarket",
  "version": "0.1.0",
  "icon": "assets/icon.png",
  "engine": "0.2.0",
  "mainScene": "scenes/menu.scene.json",
  "display": { "width": 1280, "height": 720, "scaleMode": "fit", "fullscreen": false, "vsync": true, "orientation": "landscape", "pixelArt": false },
  "physics": { "fixedHz": 60, "pixelsPerMeter": 100 },
  "input": {
    "actions": {
      "primary": ["MouseLeft", "Touch", "GamepadA"],
      "pan_drag": ["MouseRight"],
      "pan_latch": ["MouseMiddle"],
      "pan_left": ["A", "Left", "GamepadRightStickLeft"],
      "pan_right": ["D", "Right", "GamepadRightStickRight"],
      "pan_up": ["W", "Up", "GamepadRightStickUp"],
      "pan_down": ["S", "Down", "GamepadRightStickDown"],
      "zoom_in": ["PageUp", "GamepadRightTrigger"],
      "zoom_out": ["PageDown", "GamepadLeftTrigger"],
      "rotate": ["R", "GamepadY"],
      "undo": ["Z"],
      "redo": ["Y"],
      "tool_cancel": ["Q", "GamepadB"],
      "tool_demolish": ["X", "GamepadX"],
      "tool_next": ["E"],
      "tool_prev": ["C"],
      "speed_pause": ["1"],
      "speed_1": ["2"],
      "speed_2": ["3"],
      "speed_3": ["4"],
      "pause_toggle": ["Space"],
      "build_menu": ["B"],
      "delete": ["Delete"],
      "goods_table": ["G"],
      "charts": ["T"],
      "overlay": ["M"],
      "notice_jump": ["N"],
      "help": ["F1"],
      "escape": ["Escape", "GamepadB"],
      "order_board": ["O"],
      "pause": ["Escape", "P", "GamepadStart", "GamepadB"],
      "cursor_left": ["GamepadLeftStickLeft"],
      "cursor_right": ["GamepadLeftStickRight"],
      "cursor_up": ["GamepadLeftStickUp"],
      "cursor_down": ["GamepadLeftStickDown"],
      "cat_prev": ["GamepadLeftShoulder", "Home"],
      "cat_next": ["GamepadRightShoulder", "End"],
      "ui_up": ["Up", "GamepadDpadUp"],
      "ui_down": ["Down", "GamepadDpadDown"],
      "ui_left": ["Left", "GamepadDpadLeft"],
      "ui_right": ["Right", "GamepadDpadRight"],
      "ui_submit": ["Enter", "Space", "GamepadA"],
      "ui_cancel": ["Escape", "GamepadB"]
    }
  },
  "platform": {
    "achievements": [
      {
        "id": "first_ship",
        "nameKey": "achievement.first_ship.name",
        "descriptionKey": "achievement.first_ship.desc",
        "hidden": false,
        "ids": {
          "steam": "ACH_FIRST_SHIP"
        }
      },
      {
        "id": "ten_orders",
        "nameKey": "achievement.ten_orders.name",
        "descriptionKey": "achievement.ten_orders.desc",
        "hidden": false,
        "ids": {
          "steam": "ACH_TEN_ORDERS"
        }
      },
      {
        "id": "harbour_master",
        "nameKey": "achievement.harbour_master.name",
        "descriptionKey": "achievement.harbour_master.desc",
        "hidden": false,
        "ids": {
          "steam": "ACH_HARBOUR_MASTER"
        }
      },
      {
        "id": "no_debt_year",
        "nameKey": "achievement.no_debt_year.name",
        "descriptionKey": "achievement.no_debt_year.desc",
        "hidden": false,
        "ids": {
          "steam": "ACH_NO_DEBT_YEAR"
        }
      },
      {
        "id": "story_first_harbour",
        "nameKey": "achievement.story_first_harbour.name",
        "descriptionKey": "achievement.story_first_harbour.desc",
        "hidden": false,
        "ids": {
          "steam": "ACH_STORY_FIRST_HARBOUR"
        }
      },
      {
        "id": "story_river_mills",
        "nameKey": "achievement.story_river_mills.name",
        "descriptionKey": "achievement.story_river_mills.desc",
        "hidden": false,
        "ids": {
          "steam": "ACH_STORY_RIVER_MILLS"
        }
      },
      {
        "id": "story_winter_trade",
        "nameKey": "achievement.story_winter_trade.name",
        "descriptionKey": "achievement.story_winter_trade.desc",
        "hidden": false,
        "ids": {
          "steam": "ACH_STORY_WINTER_TRADE"
        }
      }
    ],
    "stats": [
      {
        "id": "ships_docked",
        "type": "int",
        "ids": {
          "steam": "ShipsDocked"
        }
      },
      {
        "id": "orders_filled",
        "type": "int",
        "ids": {
          "steam": "OrdersFilled"
        }
      },
      {
        "id": "orders_missed",
        "type": "int",
        "ids": {
          "steam": "OrdersMissed"
        }
      },
      {
        "id": "events_resolved",
        "type": "int",
        "ids": {
          "steam": "EventsResolved"
        }
      },
      {
        "id": "coins_earned",
        "type": "int",
        "ids": {
          "steam": "CoinsEarned"
        }
      },
      {
        "id": "stories_finished",
        "type": "int",
        "ids": {
          "steam": "StoriesFinished"
        }
      }
    ]
  },
  "platforms": ["web", "windows", "macos", "linux"],
  "export": {
    "exclude": ["store/**", "assets/src/**"],
    "android": {
      "adaptiveIcon": {
        "foreground": "assets/icon_fg.png",
        "background": "#7fc6dc"
      }
    }
  },
  "feedbackFile": "ENGINE_FEEDBACK.json",
  "localization": {
    "defaultLanguage": "en",
    "languages": ["en", "es", "fr", "zh-Hans"],
    "fallbackFonts": ["assets/fonts/NotoSansSC-Regular-subset.ttf"]
  }
}
