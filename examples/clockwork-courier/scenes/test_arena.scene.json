      "children": [
        {
          "id": "model",
          "components": {
            "Transform": {
              "position": [0, -0.55, 0],
              "rotation": [0, 180, 0],
              "scale": [0.23, 0.23, 0.23]
            },
            "MeshRenderer": {
              "mesh": "assets/models/robot.glb"
            },
            "Animator": {
              "params": {
                "speed": 0,
                "grounded": true,
                "vy": 0,
                "jump": false,
                "celebrate": false,
                "caught": false,
                "wind_down": false,
                "recover": false
              },
              "states": {
                "idle": {
                  "clip": "Idle"
                },
                "walk": {
                  "clip": "Walking"
                },
                "run": {
                  "clip": "Running"
                },
                "jump": {
                  "clip": "Jump",
                  "loop": false
                },
                "fall": {
                  "clip": "Jump",
                  "loop": false,
                  "speed": 0.6
                },
                "land": {
                  "clip": "Sitting",
                  "loop": false,
                  "speed": 2.5
                },
                "celebrate": {
                  "clip": "Dance",
                  "onEnter": "courier_celebrates"
                },
                "caught": {
                  "clip": "Death",
                  "loop": false
                },
                "wound_down": {
                  "clip": "Sitting",
                  "loop": false,
                  "speed": 0.5
                }
              },
              "transitions": [
                {
                  "to": "caught",
                  "when": "caught",
                  "fade": 0.1
                },
                {
                  "to": "celebrate",
                  "when": "celebrate",
                  "fade": 0.15
                },
                {
                  "to": "wound_down",
                  "when": "wind_down",
                  "fade": 0.4
                },
                {
                  "from": "caught",
                  "to": "idle",
                  "when": "recover",
                  "fade": 0.15
                },
                {
                  "from": "idle",
                  "to": "jump",
                  "when": "jump",
                  "fade": 0.08
                },
                {
                  "from": "walk",
                  "to": "jump",
                  "when": "jump",
                  "fade": 0.08
                },
                {
                  "from": "run",
                  "to": "jump",
                  "when": "jump",
                  "fade": 0.08
                },
                {
                  "from": "land",
                  "to": "jump",
                  "when": "jump",
                  "fade": 0.08
                },
                {
                  "from": "fall",
                  "to": "jump",
                  "when": "jump",
                  "fade": 0.08
                },
                {
                  "from": "jump",
                  "to": "land",
                  "when": "grounded && vy <= 0.1",
                  "fade": 0.05
                },
                {
                  "from": "fall",
                  "to": "land",
                  "when": "grounded && vy <= 0.1",
                  "fade": 0.05
                },
                {
                  "from": "idle",
                  "to": "fall",
                  "when": "!grounded && vy < -4",
                  "fade": 0.15
                },
                {
                  "from": "walk",
                  "to": "fall",
                  "when": "!grounded && vy < -4",
                  "fade": 0.15
                },
                {
                  "from": "run",
                  "to": "fall",
                  "when": "!grounded && vy < -4",
                  "fade": 0.15
                },
                {
                  "from": "land",
                  "to": "fall",
                  "when": "!grounded && vy < -4",
                  "fade": 0.15
                },
                {
                  "from": "land",
                  "to": "run",
                  "when": "speed > 3.6",
                  "fade": 0.1
                },
                {
                  "from": "land",
                  "to": "walk",
                  "when": "speed > 0.3",
                  "fade": 0.1
                },
                {
                  "from": "land",
                  "to": "idle",
                  "onFinish": true,
                  "fade": 0.15
                },
                {
                  "from": "idle",
                  "to": "walk",
                  "when": "speed > 0.3",
                  "fade": 0.15
                },
                {
                  "from": "walk",
                  "to": "run",
                  "when": "speed > 3.6",
                  "fade": 0.15
                },
                {
                  "from": "run",
                  "to": "walk",
                  "when": "speed <= 3.2 && speed > 0.3",
                  "fade": 0.15
                },
                {
                  "from": "walk",
                  "to": "idle",
                  "when": "speed <= 0.3",
                  "fade": 0.2
                },
                {
                  "from": "run",
                  "to": "idle",
                  "when": "speed <= 0.3",
                  "fade": 0.2
                }
              ],
              "events": [
                {
                  "clip": "Walking",
                  "time": 0.1,
                  "name": "footstep"
                },
                {
                  "clip": "Walking",
                  "time": 0.58,
                  "name": "footstep"
                },
                {
                  "clip": "Running",
                  "time": 0.05,
                  "name": "footstep"
                },
                {
                  "clip": "Running",
                  "time": 0.53,
                  "name": "footstep"
                }
              ],
              "state": "idle"
            }
