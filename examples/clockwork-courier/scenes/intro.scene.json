{
  "format": "factoria.scene/1",
  "entities": [
    {
      "id": "camera",
      "components": {
        "Transform": {
          "position": [640, 360, 0]
        },
        "Camera": {
          "clearColor": [0.07, 0.08, 0.13, 1]
        }
      }
    },
    {
      "id": "intro_video",
      "components": {
        "Video": {
          "path": "assets/video/studio_intro.mpg",
          "size": [1280, 720],
          "anchor": [0.5, 0.5],
          "pivot": [0.5, 0.5],
          "fit": "contain",
          "bus": "sfx",
          "color": [0.07, 0.08, 0.13, 1],
          "layer": 1
        }
      }
    },
    {
      "id": "intro_hint",
      "components": {
        "Transform": {
          "position": [0, -36, 0]
        },
        "Text": {
          "text": "Tap or press any key to skip",
          "key": "intro.hint",
          "fontSize": 22,
          "color": [0.7, 0.75, 0.9, 0.7],
          "align": "center",
          "space": "screen",
          "safeArea": true,
          "anchor": [0.5, 1],
          "pivot": [0.5, 0],
          "maxWidth": 760,
          "layer": 100
        }
      }
    },
    {
      "id": "intro_skip",
      "components": {
        "Transform": {
          "position": [-32, -28, 0]
        },
        "Button": {
          "text": "Skip",
          "key": "intro.skip",
          "size": [200, 56],
          "fontSize": 26,
          "autoShrink": true,
          "safeArea": true,
          "anchor": [1, 1],
          "pivot": [1, 0],
          "layer": 300
        }
      }
    },
    {
      "id": "intro",
      "components": {
        "Script": {
          "path": "scripts/intro.js"
        }
      }
    }
  ]
