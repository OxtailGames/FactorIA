                  "fade": 0.05
                },
                {
                  "from": "fall",
                  "to": "land",
                  "when": "grounded && vy <= 0.1",
                  "fade": 0.05
                },
                {
                  "from": "idle",
                  "to": "fall",
                  "when": "!grounded && vy < -4",
                  "fade": 0.15
                },
                {
                  "from": "walk",
                  "to": "fall",
                  "when": "!grounded && vy < -4",
                  "fade": 0.15
                },
                {
                  "from": "run",
                  "to": "fall",
                  "when": "!grounded && vy < -4",
                  "fade": 0.15
                },
                {
                  "from": "land",
                  "to": "fall",
                  "when": "!grounded && vy < -4",
                  "fade": 0.15
                },
                {
                  "from": "land",
                  "to": "run",
                  "when": "speed > 3.6",
                  "fade": 0.1
                },
                {
                  "from": "land",
                  "to": "walk",
                  "when": "speed > 0.3",
                  "fade": 0.1
                },
                {
                  "from": "land",
                  "to": "idle",
                  "onFinish": true,
                  "fade": 0.15
                },
                {
                  "from": "idle",
                  "to": "walk",
                  "when": "speed > 0.3",
                  "fade": 0.15
                },
                {
                  "from": "walk",
                  "to": "run",
                  "when": "speed > 3.6",
                  "fade": 0.15
                },
                {
                  "from": "run",
                  "to": "walk",
                  "when": "speed <= 3.2 && speed > 0.3",
                  "fade": 0.15
                },
                {
                  "from": "walk",
                  "to": "idle",
                  "when": "speed <= 0.3",
                  "fade": 0.2
                },
                {
                  "from": "run",
                  "to": "idle",
                  "when": "speed <= 0.3",
                  "fade": 0.2
                }
              ],
              "events": [
                {
                  "clip": "Walking",
                  "time": 0.1,
                  "name": "footstep"
                },
