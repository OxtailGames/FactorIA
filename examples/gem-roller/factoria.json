{
  "format": "factoria.project/1",
  "name": "Gem Roller",
  "id": "com.factoria.examples.gemroller",
  "version": "0.1.0",
  "engine": "0.1.0",
  "mainScene": "scenes/main.scene.json",
  "display": {
    "width": 1280,
    "height": 720,
    "scaleMode": "fit",
    "fullscreen": false,
    "vsync": true,
    "orientation": "landscape",
    "pixelArt": false
  },
  "physics": {
    "fixedHz": 60,
    "pixelsPerMeter": 100
  },
  "input": {
    "actions": {
      "move_forward": [
        "W",
        "Up"
      ],
      "move_back": [
        "S",
        "Down"
      ],
      "move_left": [
        "A",
        "Left"
      ],
      "move_right": [
        "D",
        "Right"
      ],
      "jump": [
        "Space"
      ],
      "cam_left": [
        "Q"
      ],
      "cam_right": [
        "E"
      ],
      "restart": [
        "R"
      ]
    }
  },
  "platforms": [
    "windows",
    "macos",
    "linux",
    "ios",
    "android"
  ],
  "feedbackFile": "ENGINE_FEEDBACK.json"
}