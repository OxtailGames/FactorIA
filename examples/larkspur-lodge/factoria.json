{
  "format": "factoria.project/1",
  "name": "Larkspur Lodge",
  "id": "com.oxtailgames.larkspurlodge",
  "version": "0.1.0",
  "engine": "0.2.0",
  "mainScene": "scenes/menu.scene.json",
  "display": {
    "width": 1280,
    "height": 720,
    "scaleMode": "fit",
    "fullscreen": false,
    "vsync": true,
    "orientation": "landscape",
    "pixelArt": false
  },
  "physics": {
    "fixedHz": 60,
    "pixelsPerMeter": 100
  },
  "input": {
    "actions": {
      "move_forward": [
        "W",
        "Up",
        "GamepadLeftStickUp"
      ],
      "move_back": [
        "S",
        "Down",
        "GamepadLeftStickDown"
      ],
      "move_left": [
        "A",
        "Left",
        "GamepadLeftStickLeft"
      ],
      "move_right": [
        "D",
        "Right",
        "GamepadLeftStickRight"
      ],
      "run": [
        "LeftShift",
        "RightShift",
        "GamepadLeftThumb"
      ],
      "interact": [
        "F",
        "Enter",
        "GamepadA"
      ],
      "camera_left": [
        "Q",
        "GamepadRightStickLeft"
      ],
      "camera_right": [
        "E",
        "GamepadRightStickRight"
      ],
      "camera_up": [
        "GamepadRightStickUp"
      ],
      "camera_down": [
        "GamepadRightStickDown"
      ],
      "zoom_in": [
        "R",
        "GamepadRightShoulder"
      ],
      "zoom_out": [
        "V",
        "GamepadLeftShoulder"
      ],
      "pause": [
        "Escape",
        "P",
        "GamepadStart"
      ],
      "dialogue_log": [
        "L",
        "GamepadY"
      ],
      "choice_1": [
        "1"
      ],
      "choice_2": [
        "2"
      ],
      "choice_3": [
        "3"
      ],
      "choice_4": [
        "4"
      ],
      "inventory": [
        "I",
        "GamepadX"
      ],
      "notebook": [
        "N",
        "GamepadBack"
      ],
      "tab_next": [
        "Tab",
        "PageDown",
        "GamepadRightShoulder"
      ],
      "tab_prev": [
        "PageUp",
        "GamepadLeftShoulder"
      ],
      "board_undo": [
        "Z",
        "GamepadLeftTrigger"
      ],
      "board_redo": [
        "Y",
        "GamepadRightTrigger"
      ],
      "view_zoom_in": [
        "R",
        "GamepadRightTrigger"
      ],
      "view_zoom_out": [
        "V",
        "GamepadLeftTrigger"
      ],
      "skip_cutscene": [
        "Space",
        "GamepadB"
      ]
    }
  },
  "audio": {
    "buses": {
      "voiceover": {}
    }
  },
  "platform": {
    "achievements": [
      {
        "id": "ending_dawn",
        "nameKey": "ach.ending_dawn.name",
        "descriptionKey": "ach.ending_dawn.desc",
        "name": "Dawn at the Lodge",
        "description": "Reach the dawn ending."
      },
      {
        "id": "ending_quiet",
        "nameKey": "ach.ending_quiet.name",
        "descriptionKey": "ach.ending_quiet.desc",
        "name": "A Quiet Morning",
        "description": "Reach the quiet ending."
      },
      {
        "id": "ending_long",
        "nameKey": "ach.ending_long.name",
        "descriptionKey": "ach.ending_long.desc",
        "name": "The Long Night",
        "description": "Reach the long night ending."
      },
      {
        "id": "all_endings",
        "nameKey": "ach.all_endings.name",
        "descriptionKey": "ach.all_endings.desc",
        "name": "Every Dawn",
        "description": "Reach all three endings."
      },
      {
        "id": "all_clues",
        "nameKey": "ach.all_clues.name",
        "descriptionKey": "ach.all_clues.desc",
        "name": "Nothing Missed",
        "description": "Find every clue in one night."
      }
    ],
    "stats": [
      {
        "id": "saves_made",
        "type": "int"
      },
      {
        "id": "endings_seen",
        "type": "int"
      },
      {
        "id": "play_minutes",
        "type": "int"
      }
    ]
  },
  "platforms": [
    "macos",
    "windows",
    "ios",
    "linux"
  ],
  "feedbackFile": "ENGINE_FEEDBACK.json",
  "localization": {
    "defaultLanguage": "en",
    "languages": [
      "en"
    ]
  }
}
