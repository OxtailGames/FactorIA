            "Animator": {
              "params": {
                "speed": 0.0,
                "interact": false,
                "pickup": false
              },
              "states": {
                "idle": {
                  "clip": "idle"
                },
                "walk": {
                  "clip": "walk"
                },
                "run": {
                  "clip": "sprint"
                },
                "interact": {
                  "clip": "interact-right",
                  "loop": false
                },
                "pickup": {
                  "clip": "pick-up",
                  "loop": false
                }
              },
              "transitions": [
                {
                  "to": "interact",
                  "when": "interact",
                  "fade": 0.1
                },
                {
                  "to": "pickup",
                  "when": "pickup",
                  "fade": 0.1
                },
                {
                  "from": "interact",
                  "to": "idle",
                  "onFinish": true,
                  "fade": 0.15
                },
                {
                  "from": "pickup",
                  "to": "idle",
                  "onFinish": true,
                  "fade": 0.15
                },
                {
                  "from": "idle",
                  "to": "walk",
                  "when": "speed > 0.3",
                  "fade": 0.15
                },
                {
                  "from": "walk",
                  "to": "run",
                  "when": "speed > 3.6",
                  "fade": 0.15
                },
                {
                  "from": "run",
                  "to": "walk",
                  "when": "speed <= 3.2 && speed > 0.3",
                  "fade": 0.15
                },
                {
                  "from": "walk",
                  "to": "idle",
                  "when": "speed <= 0.3",
                  "fade": 0.2
                },
                {
                  "from": "run",
                  "to": "idle",
                  "when": "speed <= 0.3",
                  "fade": 0.2
                }
              ],
              "events": [
                {
                  "clip": "walk",
                  "time": 0.1,
                  "name": "footstep"
                },
                {
                  "clip": "walk",
                  "time": 0.55,
                  "name": "footstep"
                },
                {
                  "clip": "sprint",
                  "time": 0.05,
                  "name": "footstep"
                },
                {
                  "clip": "sprint",
                  "time": 0.4,
                  "name": "footstep"
                }
              ],
