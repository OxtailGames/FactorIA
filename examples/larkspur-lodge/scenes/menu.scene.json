{
  "format": "factoria.scene/1",
  "entities": [
    {
      "id": "camera",
      "components": {
        "Transform": {
          "position": [640, 360, 0]
        },
        "Camera": {
          "clearColor": [0.1, 0.12, 0.18, 1]
        }
      }
    },
    {
      "id": "captions",
      "components": {
        "Transform": {
          "position": [0, -24, 0]
        },
        "Captions": {
          "maxLines": 3,
          "fontSize": 30
        }
      }
    },
    {
      "id": "main_menu",
      "components": {
        "Transform": {
          "position": [0, 20, 0]
        },
        "Panel": {
          "anchor": [0.5, 0.5],
          "color": [0, 0, 0, 0],
          "layout": "column",
          "spacing": 12,
          "fit": true
        },
        "Script": {
          "path": "scripts/main_menu.js",
          "props": {
            "firstScene": "scenes/ground.scene.json"
          }
        }
      },
      "children": [
        {
          "id": "title",
          "components": {
            "Text": {
              "text": "Larkspur Lodge",
              "key": "menu.title",
              "fontSize": 64,
              "space": "screen"
            }
          }
        },
        {
          "id": "play",
          "components": {
            "Button": {
              "autoSize": true,
              "text": "Play",
              "key": "menu.play",
              "autoFocus": true
            }
          }
        },
        {
          "id": "load_button",
          "components": {
            "Button": {
              "autoSize": true,
              "text": "Load game",
              "key": "menu.load"
            }
          }
        },
        {
          "id": "chapters_button",
          "components": {
            "Button": {
              "autoSize": true,
              "text": "Chapter select",
              "key": "menu.chapters"
            }
          }
        },
        {
          "id": "options_button",
          "components": {
            "Button": {
              "autoSize": true,
              "text": "Options",
              "key": "menu.options"
            }
          }
        },
        {
          "id": "credits_button",
          "components": {
            "Button": {
              "autoSize": true,
              "text": "Credits",
              "key": "menu.credits"
            }
          }
        },
        {
          "id": "quit",
          "components": {
            "Button": {
              "autoSize": true,
              "text": "Quit",
              "key": "menu.quit"
            }
          }
        }
      ]
    },
    {
      "id": "options",
      "active": false,
      "prefab": "prefabs/ui/options.prefab.json"
    },
    {
      "id": "credits",
      "active": false,
      "components": {
        "Panel": {
          "size": [760, 620],
          "anchor": [0.5, 0.5],
          "layer": 300,
          "layout": "column",
          "spacing": 16,
          "padding": [24, 24, 24, 24]
        },
        "Script": {
          "path": "scripts/ui/credits.js"
        }
      },
      "children": [
        {
          "id": "credits_list",
          "components": {
            "ScrollList": {
              "size": [712, 476],
              "layer": 301,
              "color": [0, 0, 0, 0.25],
              "spacing": 14,
              "padding": [16, 16, 16, 16]
            }
          }
        },
        {
          "id": "credits_back",
          "tags": ["back"],
          "components": {
            "Button": {
              "autoSize": true,
              "text": "Back",
              "key": "menu.back",
              "layer": 302,
              "autoFocus": true
            }
          }
        }
      ]
    }
  ]
}
