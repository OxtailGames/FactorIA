                "open.guest_door_c"
              ],
              "to": "dlg.ch3_hedda.again"
            },
            {
              "if": [
                "talked.hedda.3"
              ],
              "to": "dlg.ch3_hedda.again"
            },
            {
              "to": "dlg.ch3_hedda.greet"
            }
          ]
        },
        "dlg.ch3_hedda.greet": {
