    "ch3_hedda": {
      "doc": "Hedda at the door of room C holds the spare key. The torn letter, urgency or a threat each open her; 'please' does not.",
      "start": "dlg.ch3_hedda.start",
      "nodes": {
        "dlg.ch3_hedda.start": {
