    "epic": {
      "organizationId": "FAKE-org-id", "productId": "FAKE-product-id", "clientId": "FAKE-client-id",
      "artifacts": { "windows": "FAKE-artifact-win", "macos": "FAKE-artifact-mac", "linux": "FAKE-artifact-linux" }
    },
    "gog": { "productId": "1000000001", "languages": ["en-US", "es-ES", "de-DE", "ar"] },
    "appstore": { "appleId": "1000000002" },
    "googleplay": { "track": "internal", "releaseStatus": "draft", "changelogs": { "en-US": "store/whats-new-en.txt", "es-ES": "store/whats-new-es.txt", "de-DE": "store/whats-new-de.txt", "ar": "store/whats-new-ar.txt" } }
