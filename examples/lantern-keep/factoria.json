      { "id": "courtyard_clear", "name": "Courtyard Cleared", "nameKey": "achievements.courtyard_clear.name", "description": "Finish all three levels of the Courtyard.", "descriptionKey": "achievements.courtyard_clear.description" },
      { "id": "cellars_clear", "name": "Out of the Cellars", "nameKey": "achievements.cellars_clear.name", "description": "Finish all three levels of the Cellars.", "descriptionKey": "achievements.cellars_clear.description" },
      { "id": "all_embers", "name": "Ember Keeper", "nameKey": "achievements.all_embers.name", "description": "Find all 18 embers.", "descriptionKey": "achievements.all_embers.description" },
      { "id": "untouched", "name": "Untouched", "nameKey": "achievements.untouched.name", "description": "Finish a level without dying.", "descriptionKey": "achievements.untouched.description" },
