{
  "format": "factoria.project/1",
  "name": "Lantern Keep",
  "id": "com.factoria.examples.lanternkeep",
  "version": "1.0.0",
  "engine": "0.1.6",
  "mainScene": "scenes/menu.scene.json",
  "display": { "width": 1280, "height": 720, "scaleMode": "fit", "fullscreen": false, "vsync": true, "orientation": "landscape", "pixelArt": false },
  "physics": { "fixedHz": 60, "pixelsPerMeter": 100 },
  "input": {
    "actions": {
      "move_left": ["A", "Left", "GamepadDpadLeft", "GamepadLeftStickLeft"],
      "move_right": ["D", "Right", "GamepadDpadRight", "GamepadLeftStickRight"],
      "jump": ["Space", "W", "Up", "GamepadA"],
      "pause": ["Escape", "P", "GamepadStart"]
    }
  },
  "localization": { "defaultLanguage": "en", "languages": ["en", "es", "de", "ar"] },
  "platforms": ["windows", "macos", "linux", "web", "android", "ios"],
  "icon": "assets/icon.png",
  "export": {
    "scriptBytecode": true,
    "exclude": ["levels/**", "screenshots/**", "store/**"],
    "macos": { "category": "public.app-category.games", "minimumSystemVersion": "11.0", "copyright": "Copyright 2026 Oxtail Games" },
    "linux": { "categories": ["Game", "ArcadeGame"] },
    "android": {
      "format": "aab",
      "minSdk": 26,
      "targetSdk": 36,
      "versionCode": 10000,
      "adaptiveIcon": { "foreground": "assets/icon_fg.png", "background": "#141428" }
    },
    "ios": { "iconBackground": "#141428", "buildNumber": "1.0.0", "usesNonExemptEncryption": false }
  },
  "publish": {
    "steam": { "account": "FAKE_steam_build_account", "depots": { "windows": 9000001, "macos": 9000002, "linux": 9000003 } },
