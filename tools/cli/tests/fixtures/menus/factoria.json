{
  "format": "factoria.project/1",
  "name": "My Game",
  "id": "com.factoria.fixtures.menus",
  "version": "0.1.0",
  "mainScene": "scenes/menu.scene.json",
  "display": { "width": 1280, "height": 720, "scaleMode": "fit", "fullscreen": false, "vsync": true },
  "physics": { "fixedHz": 60, "pixelsPerMeter": 100 },
  "localization": { "defaultLanguage": "en", "languages": ["en", "es", "ar"] },
  "platform": {
    "achievements": [
      { "id": "first_jump", "name": "First jump", "description": "Jump once." },
      { "id": "big_spender", "name": "Big spender", "description": "Buy something in the shop." }
    ],
    "stats": [{ "id": "jumps" }],
    "products": [
      { "id": "gems_100", "type": "consumable", "title": "100 gems", "price": 0.99 },
      { "id": "remove_ads", "type": "nonConsumable", "title": "Remove ads", "price": 2.99 }
    ]
  },
  "input": {
    "actions": {
      "move_left": ["A", "Left", "GamepadDpadLeft", "GamepadLeftStickLeft"],
      "move_right": ["D", "Right", "GamepadDpadRight", "GamepadLeftStickRight"],
      "jump": ["Space", "W", "Up", "GamepadA"],
      "pause": ["Escape", "P", "GamepadStart"],
      "camera_drag": ["MouseMiddle"],
      "camera_left": ["A", "Left"],
      "camera_right": ["D", "Right"],
      "camera_up": ["W", "Up"],
      "camera_down": ["S", "Down"],
      "camera_zoom_in": ["PageUp", "Equal"],
      "camera_zoom_out": ["PageDown", "Minus"]
    }
  }
}
