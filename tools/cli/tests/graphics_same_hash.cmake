# The simulation does not need a renderer (docs/ARCHITECTURE.md, "Animation" and "Simulation without a renderer"): the sprite
# animators and the particle emitters advance in the fixed step, text is shaped and measured on the CPU with the renderer's fonts, and
# the cameras (input.mouse.world, camera.worldToScreen, the offset of a Parallax layer) are CPU maths too. So the WHOLE world -- every
# entity, component and field, the live particles, the clock and the random generator -- is the same with a GPU renderer that draws
# as with --no-graphics.
# Runs every scene of every example game for the same 40 frames both ways (with graphics it draws two frames on the way, so the
# renderer's own passes have run) and compares game.state_hash of the whole world; when it differs, the Sprite, SpriteAnimator and
# ParticleEmitter components alone are compared first, so the message says whether the animators are what differs.
#   cmake -DFACTORIA=<factoria> -DROOT=<repo> [-DEXAMPLE=<name>] -P graphics_same_hash.cmake
# One example per run (CTest registers one test for each); without EXAMPLE every example is checked.
set(components "\"Sprite\",\"SpriteAnimator\",\"ParticleEmitter\"")
if(EXAMPLE)
    set(projects ${ROOT}/examples/${EXAMPLE})
else()
    file(GLOB projects LIST_DIRECTORIES true ${ROOT}/examples/*)
endif()
set(checked 0)
set(skipped "")
set(failures "")
foreach(project ${projects})
    if(NOT EXISTS ${project}/factoria.json)
        continue()
    endif()
    get_filename_component(ex ${project} NAME)
    file(GLOB_RECURSE scene_files RELATIVE ${project} ${project}/*.scene.json)
    list(SORT scene_files)
    foreach(scene ${scene_files})
        if(scene MATCHES "^(store|node_modules|\\.factoria)/")
            continue()  # store art scenes are not game scenes
        endif()
        set(hashes_cmd "{\"command\":\"game.state_hash\",\"args\":{\"components\":[${components}]}},{\"command\":\"game.state_hash\",\"args\":{}}")
        set(failed "")
        set(part "")
        set(whole "")
        foreach(mode graphics none)
            if(mode STREQUAL "graphics")
                set(flags "")
                set(batch "[{\"command\":\"game.step\",\"args\":{\"frames\":20}},{\"command\":\"game.screenshot\",\"args\":{}},{\"command\":\"game.step\",\"args\":{\"frames\":20}},{\"command\":\"game.screenshot\",\"args\":{}},${hashes_cmd}]")
            else()
                set(flags --no-graphics)
                set(batch "[{\"command\":\"game.step\",\"args\":{\"frames\":40}},${hashes_cmd}]")
            endif()
            execute_process(COMMAND ${FACTORIA} call ${flags} --project ${project} --scene ${scene} --batch ${batch}
                            RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
            set(partHash "-")
            set(wholeHash "-")
            if(NOT rc EQUAL 0)
                set(failed "${failed} [${mode}: exit ${rc}]")
            else()
                string(JSON n LENGTH "${out}" results)
                math(EXPR lastPart "${n} - 2")
                math(EXPR lastWhole "${n} - 1")
                string(JSON partHash ERROR_VARIABLE jerr GET "${out}" results ${lastPart} result hash)
                string(JSON wholeHash ERROR_VARIABLE jerr2 GET "${out}" results ${lastWhole} result hash)
                if(jerr OR jerr2)
                    set(failed "${failed} [${mode}: no hash]")
                    set(partHash "-")
                    set(wholeHash "-")
                endif()
            endif()
            list(APPEND part ${partHash})
            list(APPEND whole ${wholeHash})
        endforeach()
        list(GET part 0 partGfx)
        list(GET part 1 partNone)
        list(GET whole 0 wholeGfx)
        list(GET whole 1 wholeNone)
        if(failed)
            # A scene that needs props or another scene to start fails the same way in both runs; it is not a result.
            if(partGfx STREQUAL partNone)
                list(APPEND skipped "${ex}/${scene}")
                continue()
            endif()
            list(APPEND failures "${ex}/${scene}: one run failed and the other did not:${failed}")
            continue()
        endif()
        if(NOT partGfx STREQUAL partNone)
            list(APPEND failures "${ex}/${scene}: the Sprite/SpriteAnimator/ParticleEmitter hash after 40 frames is ${partGfx} with a renderer and ${partNone} with --no-graphics")
        elseif(NOT wholeGfx STREQUAL wholeNone)
            list(APPEND failures "${ex}/${scene}: the hash of the whole world after 40 frames is ${wholeGfx} with a renderer and ${wholeNone} with --no-graphics, the animators and particles agree (text sizes, cameras, parallax or the live particles differ; run game.state_hash with perEntity both ways to find the entity)")
        endif()
        math(EXPR checked "${checked} + 1")
    endforeach()
endforeach()
if(checked EQUAL 0 AND NOT failures)
    if(EXAMPLE AND skipped)
        message(STATUS "${EXAMPLE}: none of its scenes starts on its own (${skipped}); nothing to compare")
        return()
    endif()
    message(FATAL_ERROR "no example scene was checked (ROOT=${ROOT}, EXAMPLE=${EXAMPLE})")
endif()
message(STATUS "${checked} example scenes checked, the whole world is the same with and without a renderer (skipped, they do not start on their own: ${skipped}).")
if(failures)
    string(REPLACE ";" "\n  " failText "${failures}")
    message(FATAL_ERROR "the simulation depends on the renderer:\n  ${failText}")
endif()
