# https://editorconfig.org. Formatting of C and C++ is decided by .clang-format (scripts/format.sh).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,cc,cpp,h,hpp,m,mm}]
max_line_length = 120

[{CMakeLists.txt,*.cmake}]
indent_size = 4

[*.{json,yml,yaml,js,mjs,ts,tsx,glsl,shader}]
indent_size = 2

[*.md]
# A trailing double space is a line break in Markdown.
trim_trailing_whitespace = false

[*.sh]
indent_size = 4

# CRLF on every checkout (.gitattributes).
[*.{bat,cmd}]
end_of_line = crlf

# Gradle wrapper script of the Android template: LF (.gitattributes).
[gradlew]
end_of_line = lf

# Byte-exact files: third party code, fuzz corpora, test data and golden files, fonts (CRLF, BOM and missing final
# newlines are part of them).
[{external/**,tools/fuzz/corpus/**,**/tests/data/**,**/tests/golden/**,engine/render/assets/fonts/**}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
max_line_length = unset

# Binary-like files.
[*.{ktx2,png,zst,lz4,bin,jar}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
