{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Shared settings. Each preset builds into build/<preset name>.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },

    {
      "name": "linux-debug",
      "displayName": "Linux x64, Debug",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-release",
      "displayName": "Linux x64, Release",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-sniper",
      "displayName": "Linux x64, Release, static libstdc++ (built inside the Steam Runtime sniper SDK by scripts/build-sniper.sh)",
      "inherits": "linux-release",
      "cacheVariables": {
        "FA_LINUX_STATIC_LIBSTDCXX": "ON",
        "FA_BUILD_TESTS": "OFF",
        "CMAKE_DISABLE_FIND_PACKAGE_CURL": "ON",
        "OpenGL_GL_PREFERENCE": "LEGACY"
      }
    },

    {
      "name": "linux-asan",
      "displayName": "Linux x64, Debug, Clang, AddressSanitizer + UndefinedBehaviorSanitizer (CI job linux-asan; docs/BUILDING.md, Sanitizers)",
      "inherits": "linux-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_FLAGS_DEBUG": "-O1 -g1",
        "CMAKE_CXX_FLAGS_DEBUG": "-O1 -g1",
        "FA_SANITIZE": "address;undefined"
      }
    },
    {
      "name": "linux-tsan",
      "displayName": "Linux x64, Debug, Clang, ThreadSanitizer (CI job linux-tsan; docs/BUILDING.md, Sanitizers)",
      "inherits": "linux-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_FLAGS_DEBUG": "-O1 -g1",
        "CMAKE_CXX_FLAGS_DEBUG": "-O1 -g1",
        "FA_SANITIZE": "thread"
      }
    },

    {
      "name": "macos-debug",
      "displayName": "macOS, Debug",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "macos-release",
      "displayName": "macOS, Release",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },

    {
      "name": "macos-asan",
      "displayName": "macOS, Debug, Apple Clang, AddressSanitizer + UndefinedBehaviorSanitizer (local runs; no leak detection on macOS)",
      "inherits": "macos-debug",
      "cacheVariables": {
        "FA_SANITIZE": "address;undefined",
        "CMAKE_C_FLAGS_DEBUG": "-O1 -g1",
        "CMAKE_CXX_FLAGS_DEBUG": "-O1 -g1",
        "CMAKE_OBJC_FLAGS_DEBUG": "-O1 -g1",
        "CMAKE_OBJCXX_FLAGS_DEBUG": "-O1 -g1"
      }
    },

    {
      "name": "windows-debug",
      "displayName": "Windows x64, Visual Studio 2022, Debug",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" }
    },
    {
      "name": "windows-release",
      "displayName": "Windows x64, Visual Studio 2022, Release",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" }
    },
    {
      "name": "windows-ninja-debug",
      "displayName": "Windows x64, Ninja + MSVC cl, Debug (run from a VS Developer prompt)",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },

    {
      "name": "ios",
      "displayName": "iOS device (arm64), Xcode",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "generator": "Xcode",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "16.3",
        "FA_BUILD_TOOLS": "OFF",
        "FA_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "ios-simulator",
      "displayName": "iOS Simulator, Xcode",
      "inherits": "ios",
      "cacheVariables": {
        "CMAKE_OSX_SYSROOT": "iphonesimulator"
      }
    },

    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a (devices), NDK; needs ANDROID_NDK_HOME",
      "inherits": "base",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-26",
        "FA_BUILD_TOOLS": "OFF",
        "FA_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "android-x86_64",
      "displayName": "Android x86_64 (emulator), NDK; needs ANDROID_NDK_HOME",
      "inherits": "base",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ANDROID_ABI": "x86_64",
        "ANDROID_PLATFORM": "android-26",
        "FA_BUILD_TOOLS": "OFF",
        "FA_BUILD_TESTS": "OFF"
      }
    },

    {
      "name": "web-debug",
      "displayName": "Web (WebAssembly, WebGL2), Emscripten, Debug; needs EMSDK (the emsdk folder, activated)",
      "inherits": "base",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FA_BUILD_TOOLS": "OFF",
        "FA_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "web-release",
      "displayName": "Web (WebAssembly, WebGL2), Emscripten, Release; needs EMSDK (the emsdk folder, activated)",
      "inherits": "web-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],

  "buildPresets": [
    { "name": "linux-debug",        "configurePreset": "linux-debug",        "configuration": "Debug" },
    { "name": "linux-release",      "configurePreset": "linux-release",      "configuration": "Release" },
    { "name": "linux-sniper",       "configurePreset": "linux-sniper",       "configuration": "Release" },
    { "name": "linux-asan",         "configurePreset": "linux-asan",         "configuration": "Debug" },
    { "name": "linux-tsan",         "configurePreset": "linux-tsan",         "configuration": "Debug" },
    { "name": "macos-debug",        "configurePreset": "macos-debug",        "configuration": "Debug" },
    { "name": "macos-asan",         "configurePreset": "macos-asan",         "configuration": "Debug" },
    { "name": "macos-release",      "configurePreset": "macos-release",      "configuration": "Release" },
    { "name": "windows-debug",      "configurePreset": "windows-debug",      "configuration": "Debug" },
    { "name": "windows-release",    "configurePreset": "windows-release",    "configuration": "Release" },
    { "name": "windows-ninja-debug", "configurePreset": "windows-ninja-debug", "configuration": "Debug" },
    { "name": "ios",                "configurePreset": "ios",                "configuration": "Debug" },
    { "name": "ios-simulator",      "configurePreset": "ios-simulator",      "configuration": "Debug" },
    { "name": "android-arm64",      "configurePreset": "android-arm64" },
    { "name": "android-x86_64",     "configurePreset": "android-x86_64" },
    { "name": "web-debug",          "configurePreset": "web-debug" },
    { "name": "web-release",        "configurePreset": "web-release" }
  ],

  "testPresets": [
    { "name": "linux-debug",         "configurePreset": "linux-debug",         "configuration": "Debug",   "output": { "outputOnFailure": true } },
    { "name": "linux-release",       "configurePreset": "linux-release",       "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "linux-asan",          "configurePreset": "linux-asan",          "configuration": "Debug",   "output": { "outputOnFailure": true } },
    { "name": "linux-tsan",          "configurePreset": "linux-tsan",          "configuration": "Debug",   "output": { "outputOnFailure": true } },
    { "name": "macos-debug",         "configurePreset": "macos-debug",         "configuration": "Debug",   "output": { "outputOnFailure": true } },
    { "name": "macos-asan",          "configurePreset": "macos-asan",          "configuration": "Debug",   "output": { "outputOnFailure": true } },
    { "name": "macos-release",       "configurePreset": "macos-release",       "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "windows-debug",       "configurePreset": "windows-debug",       "configuration": "Debug",   "output": { "outputOnFailure": true } },
    { "name": "windows-release",     "configurePreset": "windows-release",     "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "windows-ninja-debug", "configurePreset": "windows-ninja-debug", "configuration": "Debug",   "output": { "outputOnFailure": true } }
  ]
}
